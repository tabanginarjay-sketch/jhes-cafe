# ==============================================
# Jhe's Cofe' Backend — Environment Template
# Copy this file to `.env` and fill in your Airtable credentials.
# NEVER commit `.env` with real secrets to Git.
# ==============================================

APP_NAME="Jhe's Cofe' API"
APP_VERSION="0.2.0"
APP_ENV="development"
DEBUG=true

# Server & CORS
API_V1_PREFIX="/api/v1"
CORS_ORIGINS="http://localhost:3002,http://127.0.0.1:3002"

# Airtable Web API Configuration
# Generate a Personal Access Token (PAT) at: https://airtable.com/create/tokens
# Required scopes: data.records:read, data.records:write, schema.bases:read
AIRTABLE_PAT="YOUR_AIRTABLE_PAT"
AIRTABLE_BASE_ID="YOUR_BASE_ID"
AIRTABLE_API_URL="https://api.airtable.com/v0"
